// The admin console on Cloudflare Workers static assets (ADR-0020 3, RFC-0003
// §19.3): its own origin, so an XSS in the user app can never reach an admin
// token. Only the console is deployed here; the user app stays on GitHub Pages.
// No secrets in this file: wrangler signs in with `wrangler login` or, in CI,
// CLOUDFLARE_API_TOKEN from the main-only `production` environment.
//
// Deploy only after `npm run build:admin` with the real project URL, so
// dist-admin carries that project in its CSP and its _headers
// (CSP with frame-ancestors, HSTS, no-store; checked by
// scripts/check-admin-headers.mjs).
{
  "name": "yunabi-admin",
  "compatibility_date": "2026-10-22",
  "assets": {
    "directory": "./dist-admin",
  },
  // Reachable only at its own host: no *.workers.dev address, no preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    // A subdomain of the owner's Cloudflare-registered domain (2026-10-22).
    // Cloudflare creates its DNS record and certificate on deploy.
    { "pattern": "yunabi-admin.juha.dev", "custom_domain": true },
  ],
}
